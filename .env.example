# ==========================================
# MIRU ACADEMIC WORKSPACE - ENVIRONMENT VARIABLES
# ==========================================

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# SUPABASE CONFIGURATION (Cloud Database, Auth, Storage)
# ------------------------------------------
# Replace these with your project values from https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Private Object Storage Bucket for Study Materials
SUPABASE_STORAGE_BUCKET=academic-materials

# ------------------------------------------
# PLATFORM AI CONFIGURATION
# ------------------------------------------
# Platform-provided default AI engine (Gemini or OpenAI)
PLATFORM_AI_PROVIDER=gemini
PLATFORM_AI_API_KEY=your-platform-gemini-or-openai-api-key-here

# ------------------------------------------
# SECURITY & ENCRYPTION
# ------------------------------------------
# 32-byte secret key used to encrypt user BYOK API keys at rest
CREDENTIAL_ENCRYPTION_KEY=your-32-byte-hex-secret-key-0123456789abcdef

# ------------------------------------------
# OPTIONAL BACKGROUND WORKER & REDIS
# ------------------------------------------
REDIS_URL=redis://localhost:6379/0
PYTHON_WORKER_URL=http://localhost:8000

